# 知几 (ZhiJi) 后端 - 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ===========================================
# 必需配置
# ===========================================

# AI API 密钥（必须配置）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 管理员密码（必须配置，生产环境使用强密码）
ADMIN_PASSWORD=your_secure_admin_password

# ===========================================
# 可选配置
# ===========================================

# 端口号
PORT=3000

# 应用版本
APP_VERSION=v2.2026.10.14

# AI API 地址
AI_API_URL=https://api.deepseek.com

# 数据存储配置
# 聊天记录最大保存数量
MAX_CHAT_HISTORY=10000
# 聊天记录保留天数
CHAT_RETENTION_DAYS=90
# 用户档案最大数量
MAX_USER_PROFILES=50000

# 运行环境
NODE_ENV=development
