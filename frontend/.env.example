# 知几 (ZhiJi) - 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ===========================================
# 必需配置
# ===========================================

# 后端 API 地址
# 开发环境: http://localhost:3000/api
# 生产环境: https://your-backend-domain.com/api
VITE_API_URL=https://zero-backend-jrvz.onrender.com/api

# ===========================================
# 可选配置
# ===========================================

# 追踪 API（用于数据分析）
VITE_TRACKING_API_URL=https://websites-admin.zxqconsulting.com/api/tracking

# 租户标识
VITE_TENANT_SLUG=zero

# 应用版本
VITE_APP_VERSION=1.0.0

# 微信客服 ID（用于联系升级）
# 如果不配置，联系升级功能将不显示
VITE_WECHAT_ID=3740977
